[gd_scene format=3]

[ext_resource type="Script" path="res://UI/InlineConfirm.cs" id="1_confirm"]

[node name="InlineConfirm" type="MarginContainer" node_paths=PackedStringArray("QuestionLabel", "ConfirmButton", "KeepButton")]
visible = false
mouse_filter = 2
theme_override_constants/margin_bottom = 4
script = ExtResource("1_confirm")
QuestionLabel = NodePath("Panel/Layout/Question")
ConfirmButton = NodePath("Panel/Layout/Confirm")
KeepButton = NodePath("Panel/Layout/Keep")

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"InlineConfirm"

[node name="Layout" type="HBoxContainer" parent="Panel"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 10

[node name="Question" type="Label" parent="Panel/Layout"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"InlineConfirmText"
vertical_alignment = 1
text_overrun_behavior = 3

[node name="Confirm" type="Button" parent="Panel/Layout"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"InlineConfirmDanger"
text = "Confirm"

[node name="Keep" type="Button" parent="Panel/Layout"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"InlineConfirmKeep"
text = "Keep"
