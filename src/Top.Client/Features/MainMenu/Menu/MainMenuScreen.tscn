[gd_scene format=3]

[ext_resource type="Script" path="res://Features/MainMenu/Menu/MainMenuScreen.cs" id="1_screen"]
[ext_resource type="PackedScene" path="res://UI/MenuItem.tscn" id="2_item"]
[ext_resource type="Script" path="res://Features/MainMenu/Menu/ContinuePill.cs" id="3_continue"]

[node name="MainMenuScreen" type="Control" node_paths=PackedStringArray("ContinuePill", "OnlineItem", "SettingsItem", "ExitItem")]
