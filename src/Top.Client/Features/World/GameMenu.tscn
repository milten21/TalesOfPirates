size_flags_horizontal = 8

[node name="Caption" parent="ActionArea/Items/SwitchCharacter/Layout" index="0"]
text = "SWITCH CHARACTER"

[node name="LogOut" parent="ActionArea/Items" instance=ExtResource("3_item")]
layout_mode = 2
