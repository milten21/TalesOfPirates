[gd_scene format=3]

[ext_resource type="Script" path="res://Features/World/GameMenu.cs" id="1_menu"]
[ext_resource type="Script" path="res://UI/ActionArea.cs" id="2_action_area"]
[ext_resource type="PackedScene" path="res://UI/MenuItem.tscn" id="3_item"]
[ext_resource type="Script" path="res://UI/InlineConfirm.cs" id="4_confirm"]

[node name="GameMenu" type="Control" node_paths=PackedStringArray("ActionArea", "Items", "SwitchCharacterItem", "LogOutItem", "ExitItem", "Confirm", "ConfirmTitle")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_menu")
ActionArea = NodePath("ActionArea")
Items = NodePath("ActionArea/Items")
SwitchCharacterItem = NodePath("ActionArea/Items/SwitchCharacter")
LogOutItem = NodePath("ActionArea/Items/LogOut")
ExitItem = NodePath("ActionArea/Items/Exit")
Confirm = NodePath("ActionArea/Confirm")
ConfirmTitle = NodePath("ActionArea/Confirm/Layout/Title")

[node name="Dim" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"GameMenuDim"

[node name="ActionArea" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_right = -120.0
offset_bottom = -130.0
grow_horizontal = 0
grow_vertical = 0
mouse_filter = 2
script = ExtResource("2_action_area")

[node name="Items" type="VBoxContainer" parent="ActionArea"]
layout_mode = 2
size_flags_horizontal = 8
size_flags_vertical = 8
mouse_filter = 2
theme_override_constants/separation = 4

[node name="SwitchCharacter" parent="ActionArea/Items" instance=ExtResource("3_item")]
