[node name="Caption" parent="ActionArea/Items/Exit/Layout" index="0"]
text = "EXIT"

[node name="Diamond" parent="ActionArea/Items/Exit/Layout/DiamondSlot" index="0"]
theme_type_variation = &"DiamondQuiet"

[node name="Confirm" type="MarginContainer" parent="ActionArea" node_paths=PackedStringArray("QuestionLabel", "ConfirmButton", "KeepButton")]
visible = false
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
size_flags_horizontal = 8
size_flags_vertical = 8
mouse_filter = 2
script = ExtResource("4_confirm")
QuestionLabel = NodePath("Layout/Question")
ConfirmButton = NodePath("Layout/Buttons/Pill")
KeepButton = NodePath("Layout/Buttons/Cancel")

[node name="Layout" type="VBoxContainer" parent="ActionArea/Confirm"]
layout_mode = 2
mouse_filter = 2
